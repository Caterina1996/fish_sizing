# 1. Base Ubuntu 22.04 con CUDA 12.1
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive

USER root

# 2. Instalar dependencias del sistema + Python 3.10
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common curl gnupg lsb-release \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev \
    python3-dev python3-pip python-is-python3 \
    liblz4-dev sudo nano \
    && rm -rf /var/lib/apt/lists/*

# 3. ELIMINAR BLINKER (Tu solución para evitar conflictos)
RUN apt-get update && apt-get remove -y python3-blinker && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# 4. Usuario y Configuración Sudo
RUN groupadd -g ${GID} rosuser && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash rosuser && \
    usermod -aG sudo rosuser && \
    echo "rosuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/rosuser && \
    chmod 0440 /etc/sudoers.d/rosuser && \
    chown -R ${UID}:${GID} /home/rosuser

# 5. INSTALACIÓN DE LIBRERÍAS (Estrategia: Libertad pero con seguridad)
RUN python -m pip install --upgrade pip && \
    
    # A) PyTorch (Este sí tiene que ser fijo para tu CUDA 12.1)
    python -m pip install --break-system-packages \
    torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu121 && \

    # B) EL RESTO (Sin versiones fijas, SALVO Numpy < 2.0)
    # Nota: Usamos --extra-index-url para que busque en ROS y en PyPI a la vez
    python -m pip install --break-system-packages \
        "numpy<2.0" \
        opencv-contrib-python \
        open3d \
        scipy scikit-learn pandas \
        ultralytics lapx natsort cloudpickle requests termcolor hdbscan pyntcloud \
        rospy rosbag rospkg genpy roslz4 \
        --extra-index-url https://rospypi.github.io/simple/ && \
    
    python -m pip cache purge

# 6. Estética y Usuario Final
USER rosuser
ENV PATH=/home/rosuser/.local/bin:$PATH
ENV PYTHONPATH="/home/rosuser/repo/src:${PYTHONPATH}"

RUN echo "export PS1='\[\e[01;32m\]\u@\h\[\e[0m\]:\[\e[01;34m\]\w\[\e[0m\]\$ '" >> /home/rosuser/.bashrc && \
    echo "alias ll='ls -alF'" >> /home/rosuser/.bashrc

CMD ["/bin/bash"]