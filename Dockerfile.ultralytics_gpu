FROM nvidia/cuda:12.1.0-devel-ubuntu20.04

ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive

USER root

# -------------------------------------------------------------------
# 🐍 1. Install Python 3.9 + System Dependencies
# -------------------------------------------------------------------
RUN apt-get update && apt-get install -y software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
        python3.9 python3.9-venv python3.9-distutils python3.9-dev python3.9-lib2to3 \
        curl apt-transport-https ca-certificates gnupg lsb-release \
        # --- LIBRERÍAS GRÁFICAS Y DE SISTEMA NECESARIAS PARA OPENCV/QT ---
        libgl1-mesa-glx libglib2.0-0 \
        ffmpeg libsm6 libxext6 \
        libxcb-xinerama0 libxcb-cursor0 libx11-xcb1 libqt5x11extras5 && \
    rm -rf /var/lib/apt/lists/*

# Set Python 3.9 as default system python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.9 2 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 2 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.9

# -------------------------------------------------------------------
# 👤 2. Create rosuser
# -------------------------------------------------------------------
RUN groupadd -g ${GID} rosuser && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash rosuser && \
    chown -R ${UID}:${GID} /home/rosuser

# -------------------------------------------------------------------
# 🐳 3. Install Docker CLI inside container
# -------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    apt-transport-https ca-certificates curl gnupg lsb-release && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu focal stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y docker-ce-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 998 docker || true && usermod -aG docker rosuser || true

# -------------------------------------------------------------------
# 📦 4. Install Python Global Dependencies (ROOT)
# -------------------------------------------------------------------
RUN mkdir -p /var/lib/apt/lists/partial && chmod 755 /var/lib/apt/lists/partial && \
    apt-get update && apt-get install -y python3-pip && \
    python3.9 -m pip install --upgrade pip && \
    
    # A) PyTorch
    python3.9 -m pip install torch==2.1.0+cu121 torchvision==0.16.0+cu121 torchaudio==2.1.0 --index-url https://download.pytorch.org/whl/cu121 && \
    
    # B) NUMPY SEGURO (Evita la v2.0 que rompe YOLO)
    python3.9 -m pip install "numpy==1.24.4" && \

    # C) ULTRALYTICS + TRACKING (Esto instalará opencv-python malo, lo arreglamos abajo)
    python3.9 -m pip install ultralytics==8.3.0 lapx natsort cloudpickle requests termcolor && \
    
    # D) LA LIMPIEZA DE OPENCV (Critical Step)
    # 1. Borramos cualquier opencv básico que haya metido ultralytics
    python3.9 -m pip uninstall opencv-python opencv-python-headless -y || true && \
    # 2. Instalamos la versión CONTRIB compatible con NumPy 1.24 (4.8.x es muy estable)
    python3.9 -m pip install "opencv-contrib-python==4.8.0.76" open3d && \
    
    python3.9 -m pip cache purge

# -------------------------------------------------------------------
# 👤 5. User Setup
# -------------------------------------------------------------------
USER rosuser
ENV PATH=/home/rosuser/.local/bin:$PATH

# Si tu requirements.txt tiene "opencv-python", deberías quitar esa línea antes de copiarlo,
# o comentar el RUN de abajo si ya has instalado todo lo necesario arriba.
COPY requirements_py311.txt /tmp/requirements_py311_project.txt
# Usamos || echo para que si falla algo no rompa el build, ya que lo vital está instalado arriba
RUN python3.9 -m pip install -r /tmp/requirements_py311_project.txt --no-cache-dir || echo "Warning: Requirements file had conflicts, relying on global libs."

CMD ["/bin/bash"]