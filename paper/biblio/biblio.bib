   doi = {10.1016/j.aquaeng.2022.102299},
   issn = {01448609},
   journal = {Aquacultural Engineering},
   keywords = {Automatic fish sizing,Biomass estimation,Computer vision,Convolutional neural networks,Fishery management,Underwater stereo vision},
   month = {11},
   note = {Atunes con stereo fitting a deformable model of the tuna<br/>Solo visto desde arriba},
   publisher = {Elsevier B.V.},
   title = {Impact evaluation of deep learning on image segmentation for automatic bluefin tuna sizing},
   volume = {99},
   year = {2022}
}
