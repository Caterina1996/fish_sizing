@article{Szymak2020,
   abstract = {Video image processing and object classification using a Deep Learning Neural Network (DLNN) can significantly increase the autonomy of underwater vehicles. This paper describes the results of a project focused on using DLNN for Object Classification in Underwater Video (OCUV) implemented in a Biomimetic Underwater Vehicle (BUV). The BUV is intended to be used to detect underwater mines, explore shipwrecks or observe the process of corrosion of munitions abandoned on the seabed after World War II. Here, the pretrained DLNNs were used for classification of the following type of objects: fishes, underwater vehicles, divers and obstacles. The results of our research enabled us to estimate the effectiveness of using pretrained DLNNs for classification of different objects under the complex Baltic Sea environment. The Genetic Algorithm (GA) was used to establish tuning parameters of the DLNNs. Three different training methods were compared for AlexNet, then one training method was chosen for fifteen networks and the tests were provided with the description of the final results. The DLNNs were trained on servers with six medium class Graphics Processing Units (GPUs). Finally, the trained DLNN was implemented in the Nvidia JetsonTX2 platform installed on board of the BUV, and one of the network was verified in a real environment.},
   author = {Piotr Szymak and Paweł Piskur and Krzysztof Naus},
   doi = {10.3390/RS12183020},
   issn = {20724292},
   issue = {18},
   journal = {Remote Sensing},
   keywords = {AlexNet,Deep learning neural network,DenseNet 201,Genetic algorithm,GoogleNet,Inception ResNet v2,Inceptionv3,MobileNetV2,NASNet Mobile,Object clasiffication in underwater video,ResNet 101,ResNet 18,ResNet 50,ShuffleNet,SqueezeNet,VGG 16,VGG 19,Xception},
   pages = {1-19},
   title = {The effectiveness of using a pretrained deep learning neural networks for object classification in underwater video},
   volume = {12},
   year = {2020},
}

